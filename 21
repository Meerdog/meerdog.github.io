<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>21 Knob: Tabletop Simulator</title>
    <style>
        :root {
            --lane-left: #a0c4ff;
            --lane-center: #e5e5e5;
            --lane-right: #fdffb6;
            --p1-color: #2a6fdb;
            --p2-color: #d62828;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #2b2b2b;
            color: #fff;
            margin: 0;
            padding: 20px;
            display: flex;
            gap: 20px;
            justify-content: center;
        }
        .dashboard {
            background: #3d3d3d;
            padding: 15px;
            border-radius: 8px;
            width: 250px;
        }
        .board-container {
            background: #fff;
            padding: 10px;
            border-radius: 8px;
            border: 5px solid #8b5a2b; /* Wood border */
        }
        .door {
            height: 40px;
            background: #8b5a2b;
            margin-bottom: 10px;
            text-align: center;
            line-height: 40px;
            font-weight: bold;
            color: white;
            border-radius: 4px;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(7, 40px);
            grid-template-rows: repeat(15, 40px);
            gap: 2px;
            background: #ccc;
            border: 2px solid #333;
        }
        .cell {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        .lane-L { background-color: var(--lane-left); }
        .lane-C { background-color: var(--lane-center); }
        .lane-R { background-color: var(--lane-right); }
        
        .player {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            position: absolute;
            z-index: 2;
            border: 2px solid white;
        }
        .p1 { background-color: var(--p1-color); }
        .p2 { background-color: var(--p2-color); }
        .ball {
            width: 12px;
            height: 12px;
            background-color: #ffb703;
            border-radius: 50%;
            position: absolute;
            z-index: 3;
            box-shadow: 0 0 5px rgba(0,0,0,0.5);
        }
        
        .controls {
            background: #3d3d3d;
            padding: 15px;
            border-radius: 8px;
            width: 300px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        select, button {
            padding: 8px;
            font-size: 14px;
            border-radius: 4px;
            border: none;
        }
        button {
            background: #fca311;
            color: #000;
            font-weight: bold;
            cursor: pointer;
        }
        button:hover { background: #e59400; }
        
        #log {
            background: #1e1e1e;
            height: 250px;
            overflow-y: auto;
            padding: 10px;
            font-family: monospace;
            font-size: 12px;
            border-radius: 4px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .log-entry { border-bottom: 1px solid #333; padding-bottom: 5px; }
        .highlight { color: #fca311; font-weight: bold; }
        .stamina-bar { display: flex; gap: 2px; margin-top: 5px; }
        .stamina-pip { width: 15px; height: 15px; background: #555; }
        .stamina-pip.filled { background: #4cc9f0; }
        .stamina-pip.lactic { background: #d62828; }
    </style>
</head>
<body>

    <div class="dashboard">
        <h2 style="color: var(--p1-color)">Player 1</h2>
        <div>Score: <span id="p1-score">0</span></div>
        <div>Stamina:</div>
        <div id="p1-stamina" class="stamina-bar"></div>
        <hr>
        <h2 style="color: var(--p2-color)">Player 2</h2>
        <div>Score: <span id="p2-score">0</span></div>
        <div>Stamina:</div>
        <div id="p2-stamina" class="stamina-bar"></div>
    </div>

    <div class="board-container">
        <div class="door">THE 3D DOOR</div>
        <div class="grid" id="board">
            </div>
    </div>

    <div class="controls">
        <h3>Action Panel</h3>
        <div id="turn-indicator" style="font-weight: bold; margin-bottom: 10px;"></div>
        
        <div style="background: #222; padding: 10px; border-radius: 4px;">
            <strong>Ball Info:</strong><br>
            State: <span id="ball-state">Mid</span><br>
            Free Moves Given: <span id="ball-free">1</span><br>
            Est. Stamina Cost: <span id="move-cost">0</span>
        </div>

        <label>Target Zone:</label>
        <select id="target-select">
            <option value="Top">Top Panel (TN 3) - High Lob</option>
            <option value="Center" selected>Center Panel (TN 2) - Safe</option>
            <option value="Bottom">Bottom Panel (TN 4) - Drop Shot</option>
            <option value="Frame">Door Frame (TN 5) - Chaos</option>
            <option value="Knob">The Knob (TN 6) - Glory!</option>
        </select>

        <label>Power Level:</label>
        <select id="power-select">
            <option value="1">Power 1 (Lob) [+1 Acc, Give 3 Moves]</option>
            <option value="2" selected>Power 2 (Drive) [0 Acc, Give 1 Move]</option>
            <option value="3">Power 3 (Bullet) [-2 Acc, Give 0 Moves]</option>
        </select>

        <button onclick="executeTurn()">TAKE SHOT & ROLL D6</button>
        <button onclick="recoverTurn()" style="background: #555; color: white;">CATCH BREATH (Skip turn, +3 Stamina)</button>

        <h3>Game Log</h3>
        <div id="log"></div>
    </div>

<script>
    // Game State
    const COLS = 7;
    const ROWS = 15;
    
    let state = {
        p1: { id: 'P1', x: 3, y: 14, score: 0, stam: 10, maxStam: 10, color: 'p1' },
        p2: { id: 'P2', x: 3, y: 12, score: 0, stam: 10, maxStam: 10, color: 'p2' },
        ball: { x: 3, y: 14, state: 'Mid', freeMove: 1 },
        activePlayer: 1, // 1 or 2
        server: 1
    };

    function log(msg) {
        const logDiv = document.getElementById('log');
        logDiv.innerHTML += `<div class="log-entry">${msg}</div>`;
        logDiv.scrollTop = logDiv.scrollHeight;
    }

    function initBoard() {
        const board = document.getElementById('board');
        board.innerHTML = '';
        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                let cell = document.createElement('div');
                cell.className = 'cell';
                if (x < 2) cell.classList.add('lane-L');
                else if (x > 4) cell.classList.add('lane-R');
                else cell.classList.add('lane-C');
                cell.id = `cell-${x}-${y}`;
                board.appendChild(cell);
            }
        }
        updateVisuals();
    }

    function updateVisuals() {
        // Clear old entities
        document.querySelectorAll('.player').forEach(e => e.remove());
        document.querySelectorAll('.ball').forEach(e => e.remove());

        // Draw P1
        let p1Div = document.createElement('div');
        p1Div.className = 'player p1';
        document.getElementById(`cell-${state.p1.x}-${state.p1.y}`).appendChild(p1Div);

        // Draw P2
        let p2Div = document.createElement('div');
        p2Div.className = 'player p2';
        document.getElementById(`cell-${state.p2.x}-${state.p2.y}`).appendChild(p2Div);

        // Draw Ball
        let ballDiv = document.createElement('div');
        ballDiv.className = 'ball';
        document.getElementById(`cell-${state.ball.x}-${state.ball.y}`).appendChild(ballDiv);

        // Update Dashboards
        document.getElementById('p1-score').innerText = state.p1.score;
        document.getElementById('p2-score').innerText = state.p2.score;
        
        renderStamina('p1', state.p1);
        renderStamina('p2', state.p2);

        let active = state.activePlayer === 1 ? state.p1 : state.p2;
        let pColor = active.id === 'P1' ? 'var(--p1-color)' : 'var(--p2-color)';
        document.getElementById('turn-indicator').innerHTML = `Current Turn: <span style="color:${pColor}">${active.id}</span>`;
        
        document.getElementById('ball-state').innerText = state.ball.state;
        document.getElementById('ball-free').innerText = state.ball.freeMove;
        
        let dist = Math.max(Math.abs(active.x - state.ball.x), Math.abs(active.y - state.ball.y));
        let cost = Math.max(0, dist - state.ball.freeMove);
        document.getElementById('move-cost').innerText = `${cost} Stamina`;
    }

    function renderStamina(id, player) {
        let bar = document.getElementById(`${id}-stamina`);
        bar.innerHTML = '';
        for(let i=1; i<=10; i++) {
            let pip = document.createElement('div');
            pip.className = 'stamina-pip';
            if (i > player.maxStam) pip.classList.add('lactic');
            else if (i <= player.stam) pip.classList.add('filled');
            bar.appendChild(pip);
        }
    }

    function getTN(target) {
        const tns = { 'Top': 3, 'Center': 2, 'Bottom': 4, 'Frame': 5, 'Knob': 6 };
        return tns[target];
    }

    function scorePoint(player, points) {
        if (player.score === 21) {
            if (points === 3) {
                log(`<span class="highlight">MATCH WINNER! ${player.id} HIT THE VICTORY KNOB!</span>`);
            } else {
                log(`${player.id} is at 21! Must hit Knob to win. 0 points awarded.`);
            }
            return;
        }

        let newScore = player.score + points;
        if (newScore > 21) {
            log(`${player.id} scored over 21. <span class="highlight">Bust!</span> Score remains ${player.score}.`);
        } else {
            player.score = newScore;
            log(`<span class="highlight">${player.id} scores ${points} point(s)! Total: ${player.score}</span>`);
        }
        
        // Reset Serve
        state.server = state.activePlayer; // Winner gets serve
        state.ball.x = 3; state.ball.y = 14; state.ball.state = 'Mid'; state.ball.freeMove = 3;
        state.p1.x = 3; state.p1.y = 14; state.p2.x = 4; state.p2.y = 14;
        state.activePlayer = state.server;
    }

    function recoverTurn() {
        let p = state.activePlayer === 1 ? state.p1 : state.p2;
        p.stam = Math.min(p.maxStam, p.stam + 3);
        log(`${p.id} caught their breath (+3 Stam). Opponent gets an easy setup!`);
        state.ball.state = 'High';
        state.ball.freeMove = 3;
        state.activePlayer = state.activePlayer === 1 ? 2 : 1;
        updateVisuals();
    }

    function executeTurn() {
        let p = state.activePlayer === 1 ? state.p1 : state.p2;
        let opponent = state.activePlayer === 1 ? state.p2 : state.p1;
        let target = document.getElementById('target-select').value;
        let power = parseInt(document.getElementById('power-select').value);
        let tn = getTN(target);

        // 1. Move to Ball
        let dist = Math.max(Math.abs(p.x - state.ball.x), Math.abs(p.y - state.ball.y));
        let cost = Math.max(0, dist - state.ball.freeMove);
        
        if (cost > p.stam) {
            log(`<b>DESPERATION DIVE!</b> ${p.id} didn't have ${cost} stamina. Prone on the floor!`);
            p.stam = 0;
            power = 1; // Forced
            target = 'Center';
            tn = 2;
        } else {
            p.stam -= cost;
            log(`${p.id} moves to ball. Spent ${cost} Stamina.`);
        }
        p.x = state.ball.x;
        p.y = state.ball.y;

        // 2. Calculate Modifiers
        let mod = 0;
        let modifiersLog = [];

        if (cost >= 3) { mod -= 1; modifiersLog.push("-1 Exhausted"); }
        if (p.x < 2 || p.x > 4) { mod -= 1; modifiersLog.push("-1 Off-Axis"); }
        if (state.ball.state === 'Low' && target !== 'Bottom') { mod -= 2; modifiersLog.push("-2 Low Ball Trap"); }
        
        if (state.ball.state === 'High' && power === 3) {
            modifiersLog.push("+0 Smash (High Ball cancels Power 3 penalty!)");
        } else if (power === 3) {
            mod -= 2; modifiersLog.push("-2 Bullet Power");
        } else if (power === 1) {
            mod += 1; modifiersLog.push("+1 Gentle Lob");
        }

        if (p.stam === 0 && cost > p.stam) { mod -= 2; modifiersLog.push("-2 Diving"); } // Dive penalty

        // 3. Roll
        let roll = Math.floor(Math.random() * 6) + 1;
        let total = roll + mod;
        log(`${p.id} aims at ${target}. Base TN: ${tn}. Rolled <span class="highlight">${roll}</span>. Mods: [${modifiersLog.join(', ')}] = Total: <b>${total}</b>`);

        // Center-to-Knob Pipeline check
        if (target === 'Center' && p.x >= 2 && p.x <= 4 && roll === 6) {
            log(`<b>PING!</b> Center-to-Knob Pipeline! Natural 6 from Center Lane hits the Knob!`);
            scorePoint(p, 3);
            updateVisuals();
            return;
        }

        // 4. Resolve
        if (total <= 0) {
            log(`<b>WHIFF!</b> ${p.id} shanked the ball into the wall.`);
            scorePoint(opponent, 1);
        } else if (total < tn) {
            log(`<b>FAIL.</b> Ball goes High and deep.`);
            state.ball.state = 'High';
            state.ball.freeMove = 3;
            scatterBall(8, 10);
            state.activePlayer = state.activePlayer === 1 ? 2 : 1;
        } else {
            log(`<b>SUCCESS!</b> Hit ${target}.`);
            if (target === 'Knob') {
                scorePoint(p, 3);
            } else {
                if (target === 'Top') { state.ball.state = 'High'; scatterBall(8, 10); }
                if (target === 'Center') { state.ball.state = 'Mid'; scatterBall(5, 7); }
                if (target === 'Bottom') { state.ball.state = 'Low'; scatterBall(1, 3); }
                if (target === 'Frame') { state.ball.state = 'Mid'; scatterBall(2, 12); } // Chaos

                if (power === 1) state.ball.freeMove = 3;
                if (power === 2) state.ball.freeMove = 1;
                if (power === 3) state.ball.freeMove = 0;
                
                state.activePlayer = state.activePlayer === 1 ? 2 : 1;
            }
        }
        updateVisuals();
    }

    function scatterBall(minY, maxY) {
        state.ball.y = Math.floor(Math.random() * (maxY - minY + 1)) + minY;
        let scatterX = Math.floor(Math.random() * 3) - 1; // -1, 0, or 1
        state.ball.x = Math.max(0, Math.min(6, state.ball.x + scatterX));
        log(`Ball lands at Row ${state.ball.y}, Lane ${state.ball.x}`);
    }

    initBoard();
</script>
</body>
</html>
